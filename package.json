{
  "name": "busy-streets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "next build",
    "check": "pnpm typecheck && pnpm test",
    "dev": "next dev",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "test": "vitest run",
    "test:ui": "vitest run --environment jsdom tests/visualization/components",
    "test:watch": "vitest",
    "traffic:audit": "tsx scripts/traffic/cli.ts audit",
    "traffic:inspect": "tsx scripts/traffic/cli.ts inspect",
    "traffic:register": "tsx scripts/traffic/cli.ts register",
    "traffic:visualize": "tsx scripts/traffic/cli.ts visualize",
    "traffic:visualize:public": "tsx scripts/traffic/export-public-visualization.ts",
    "traffic:verify": "tsx scripts/traffic/cli.ts verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@turf/along": "7.4.0",
    "@turf/bearing": "7.4.0",
    "@turf/boolean-intersects": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/buffer": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/length": "7.4.0",
    "@turf/line-split": "7.4.0",
    "@turf/nearest-point-on-line": "7.4.0",
    "csv-parse": "7.0.2",
    "fast-xml-parser": "5.11.1",
    "maplibre-gl": "6.6.0",
    "next": "16.3.3",
    "proj4": "2.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shapefile": "0.6.6",
    "unzipper": "0.12.5",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/shapefile": "0.6.4",
    "@types/unzipper": "0.10.11",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
